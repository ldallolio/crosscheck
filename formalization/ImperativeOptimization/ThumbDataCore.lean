import ImperativeOptimization.ThumbCore
import ImperativeOptimization.CheckerCore

/-!
# Loop bounds of Cortex-M0 machine code: data effects and the certificate check

The executable part (no mathlib) of the check of loop bounds on the machine code, so that
the loop rows of `ThumbCore` need not be trusted:

* `effect`: the effect of an instruction on the low registers `r0`-`r7` and on the flags
  (`Eff`): a register gets the sum or difference of two operands modulo `2^32`, or any
  value; the flags are kept, become those of an addition or subtraction (`FEff`), or any.
  Modelled exactly: ADDS, SUBS, MOVS (immediate), CMP, CMN and MOV/ADD between low
  registers; LSLS (immediate; `x · 2^s`, two cases: no overflow, or `x · 2^s ≥ 2^32` and
  any value; the flags any; with `s = 0` it is MOVS between low registers); MVNS (`(2^32 − 1) − x`; the flags any) and NEGS (`0 − x`, the flags of the
  subtraction); the write-back of STM and LDM (the base advances by four bytes per
  register; STM writes no register of its list; LDM with the base in its list writes the
  base with any value; an empty list, unpredictable in ARMv6-M, writes any value); LDR
  (literal), which loads the word of the code at its address when both halfwords are
  code (assumption: the code is not written during a run; otherwise any value). Every
  other instruction writes the registers it may write with any value, and changes the
  flags with any value if it may change them. A call (`BL`) may
  change `r0`-`r3` and the flags or, without the assumption `abi` (the AAPCS: a callee
  preserves `r4`-`r7`), every low register. This is a part of the specification of the
  processor, trusted as `decode` is.
* `condFacts`: what the outcome of a conditional branch says about the operands of the
  addition or subtraction that set the flags, as a disjunction of linear constraints.
* The certificate of a function (`DFun`): per instruction the kind of operation that set
  the flags (`FKind`) and an invariant (linear constraints on the registers and on two
  ghost variables, the operands of that operation); per certified loop (`LoopCert`) a
  header, a body, a scale `D`, a bound `N` and a potential (an affine function) for each
  instruction of the body; Farkas multipliers for every proof obligation.
* `checkData`: the obligations of every transition (the invariant of the successor and the
  descent of every potential, `k + Φ(next) − Φ(here) ≤ 0` where `k` is the transition's
  coefficient in the loop row), checked with `Checker.entails1`.

The loop row of a certified loop is generated by the checker (`loopRow`): `D` on the
transitions from the body to the header, `−N` on those from outside, right-hand side `N`
if the function's entry is in the body and `0` otherwise. `ThumbData.data_sound` proves
that every run in the data semantics satisfies these rows, so they become theorems.
-/

namespace ImperativeOptimization.Thumb

open ImperativeOptimization.Checker (Lin PExp entails1 vadd vsmul unit)


/-- An operand: a low register or a constant. -/
inductive Src where
  | reg (i : Nat)
  | imm (k : Nat)
  deriving DecidableEq, Repr

/-- The value written into a register: a sum or a difference modulo `2^32`, a shift
    `a · 2^k` modulo `2^32`, or any value. -/
inductive Val where
  | add (a b : Src)
  | sub (a b : Src)
  | shl (a : Src) (k : Nat)
  | any
  deriving DecidableEq, Repr

/-- The effect on the flags. -/
inductive FEff where
  | keep
  | any
  | add (a b : Src)
  | sub (a b : Src)
  deriving DecidableEq, Repr

/-- The effect of an instruction: the low registers it writes, the flags. -/
structure Eff where
  dst : List (Nat × Val)
  fl : FEff
  deriving DecidableEq, Repr

def anyRegs (l : List Nat) : List (Nat × Val) := l.map fun i => (i, .any)

/-- The low registers of a register list. -/
def lowList (h : Nat) : List Nat := (List.range 8).filter fun i => (h >>> i) % 2 = 1

/-- The effect of the instruction at `a` on the low registers and the flags (see the
    module documentation). Instructions that are `stop` for `decode` have no successor and
    are refused by the check; their effect does not matter. -/
def effect (abi : Bool) (c : Code) (a : Nat) : Eff :=
  match c.get a with
  | none => ⟨[], .any⟩
  | some h =>
  let top5 := h >>> 11
  let rd := h % 8
  let rn := (h >>> 3) % 8
  if top5 = 0b11101 ∨ top5 = 0b11110 ∨ top5 = 0b11111 then
    -- BL (the other 32-bit instructions are `stop`)
    ⟨anyRegs (if abi then [0, 1, 2, 3] else List.range 8), .any⟩
  -- LSLS (immediate): `rm · 2^s` modulo `2^32`; `s = 0` is MOVS rd, rm
  else if top5 = 0 then
    let s := (h >>> 6) % 32
    ⟨[(rd, if s = 0 then .add (.reg rn) (.imm 0) else .shl (.reg rn) s)], .any⟩
  -- LSRS, ASRS (immediate)
  else if top5 ≤ 2 then ⟨[(rd, .any)], .any⟩
  -- ADDS/SUBS register or 3-bit immediate
  else if top5 = 3 then
    let m := (h >>> 6) % 8
    match (h >>> 9) % 4 with
    | 0 => ⟨[(rd, .add (.reg rn) (.reg m))], .add (.reg rn) (.reg m)⟩
    | 1 => ⟨[(rd, .sub (.reg rn) (.reg m))], .sub (.reg rn) (.reg m)⟩
    | 2 => ⟨[(rd, .add (.reg rn) (.imm m))], .add (.reg rn) (.imm m)⟩
    | _ => ⟨[(rd, .sub (.reg rn) (.imm m))], .sub (.reg rn) (.imm m)⟩
  -- MOVS, CMP, ADDS, SUBS with an 8-bit immediate (MOVS: N and Z change)
  else if top5 ≤ 7 then
    let r := (h >>> 8) % 8
    let k := h % 256
    match top5 % 4 with
    | 0 => ⟨[(r, .add (.imm k) (.imm 0))], .any⟩
    | 1 => ⟨[], .sub (.reg r) (.imm k)⟩
    | 2 => ⟨[(r, .add (.reg r) (.imm k))], .add (.reg r) (.imm k)⟩
    | _ => ⟨[(r, .sub (.reg r) (.imm k))], .sub (.reg r) (.imm k)⟩
  -- data processing: CMP, CMN, TST write only the flags
  else if h >>> 10 = 0b010000 then
    let opc := (h >>> 6) % 16
    if opc = 10 then ⟨[], .sub (.reg rd) (.reg rn)⟩
    else if opc = 11 then ⟨[], .add (.reg rd) (.reg rn)⟩
    else if opc = 8 then ⟨[], .any⟩
    -- NEGS (RSBS rd, rn, #0) and MVNS
    else if opc = 9 then ⟨[(rd, .sub (.imm 0) (.reg rn))], .sub (.imm 0) (.reg rn)⟩
    else if opc = 15 then ⟨[(rd, .sub (.imm (U - 1)) (.reg rn))], .any⟩
    else ⟨[(rd, .any)], .any⟩
  -- high registers: ADD, CMP, MOV (ADD and MOV keep the flags), BX/BLX
  else if h >>> 10 = 0b010001 then
    let opc := (h >>> 8) % 4
    let d := ((h >>> 7) % 2) * 8 + h % 8
    let m := (h >>> 3) % 16
    if opc = 0 then
      (if d < 8 then (if m < 8 then ⟨[(d, .add (.reg d) (.reg m))], .keep⟩ else ⟨[(d, .any)], .keep⟩)
       else ⟨[], .keep⟩)
    else if opc = 1 then ⟨[], .any⟩
    else if opc = 2 then
      (if d < 8 then (if m < 8 then ⟨[(d, .add (.reg m) (.imm 0))], .keep⟩ else ⟨[(d, .any)], .keep⟩)
       else ⟨[], .keep⟩)
    else ⟨[], .keep⟩
  -- LDR (literal): the word of the code at `Align(a + 4, 4) + 4·imm8`
  else if top5 = 0b01001 then
    let ad := (a + 4) / 4 * 4 + 4 * (h % 256)
    match c.get ad, c.get (ad + 2) with
    | some l, some u =>
      if l < 65536 ∧ u < 65536 then ⟨[((h >>> 8) % 8, .add (.imm (l + 65536 * u)) (.imm 0))], .keep⟩
      else ⟨[((h >>> 8) % 8, .any)], .keep⟩
    | _, _ => ⟨[((h >>> 8) % 8, .any)], .keep⟩
  -- loads and stores, register offset (opcodes 3-7 load)
  else if h >>> 12 = 0b0101 then
    (if (h >>> 9) % 8 ≥ 3 then ⟨[(rd, .any)], .keep⟩ else ⟨[], .keep⟩)
  -- loads and stores, immediate offset (bit 11: load)
  else if h >>> 13 = 0b011 ∨ h >>> 12 = 0b1000 then
    (if (h >>> 11) % 2 = 1 then ⟨[(rd, .any)], .keep⟩ else ⟨[], .keep⟩)
  -- SP-relative
  else if h >>> 12 = 0b1001 then
    (if (h >>> 11) % 2 = 1 then ⟨[((h >>> 8) % 8, .any)], .keep⟩ else ⟨[], .keep⟩)
  -- ADR, ADD (SP plus immediate)
  else if top5 = 0b10100 ∨ top5 = 0b10101 then ⟨[((h >>> 8) % 8, .any)], .keep⟩
  -- miscellaneous: extend and REV write `rd`, POP its list; SP adjust, PUSH, hints nothing
  else if h >>> 12 = 0b1011 then
    if h >>> 8 = 0b10110010 ∨ h >>> 8 = 0b10111010 then ⟨[(rd, .any)], .keep⟩
    else if h >>> 9 = 0b1011110 then ⟨anyRegs (lowList h), .keep⟩
    else ⟨[], .keep⟩
  -- STM (the base written back), LDM (the list, and the base written back if not in it)
  else if h >>> 12 = 0b1100 then
    let b := (h >>> 8) % 8
    let l := lowList h
    if l = [] then ⟨anyRegs [b], .keep⟩
    else if (h >>> 11) % 2 = 0 then ⟨[(b, .add (.reg b) (.imm (4 * l.length)))], .keep⟩
    else if l.contains b then ⟨anyRegs l, .keep⟩
    else ⟨(b, .add (.reg b) (.imm (4 * l.length))) :: anyRegs l, .keep⟩
  -- branches
  else ⟨[], .keep⟩

/-! ### The stack: the stack pointer and the words of the frame -/

/-- The effect on the stack pointer: kept, moved by a constant, any value. -/
inductive SpE where
  | keep
  | add (k : Int)
  | any
  deriving DecidableEq, Repr

/-- The effect on memory: none; a word stored at `sp + imm` from register `rt`; the `n`
    words below the stack pointer written (PUSH); a store through another register or a
    call (`other`: any word may change, except, with the assumption `frame`, those of the
    function's frame). -/
inductive MemE where
  | keep
  | storeSP (imm rt : Nat)
  | push (n : Nat)
  | other
  deriving DecidableEq, Repr

/-- The effect of an instruction on the stack: stack pointer, memory, a word loaded from
    `sp + imm` into register `rt` (`load = some (rt, imm)`), and whether it writes an address
    of the frame into a register (`escapes`). -/
structure StackE where
  sp : SpE
  mem : MemE
  load : Option (Nat × Nat)
  escapes : Bool
  deriving DecidableEq, Repr

/-- The effect of the instruction at `a` on the stack (the specification; `BL`: the stack
    pointer is restored by the callee under the assumption `abi`). -/
def stackEffect (abi : Bool) (c : Code) (a : Nat) : StackE :=
  match c.get a with
  | none => ⟨.any, .other, none, true⟩
  | some h =>
  let top5 := h >>> 11
  if top5 = 0b11101 ∨ top5 = 0b11110 ∨ top5 = 0b11111 then
    ⟨if abi then .keep else .any, .other, none, false⟩
  -- LDR/STR (SP-relative)
  else if h >>> 12 = 0b1001 then
    if (h >>> 11) % 2 = 1 then ⟨.keep, .keep, some ((h >>> 8) % 8, (h % 256) * 4), false⟩
    else ⟨.keep, .storeSP ((h % 256) * 4) ((h >>> 8) % 8), none, false⟩
  -- ADD rd, SP, #imm: an address of the frame in a register
  else if top5 = 0b10101 then ⟨.keep, .keep, none, true⟩
  -- ADD/SUB SP, #imm
  else if h >>> 8 = 0b10110000 then
    ⟨.add (if (h >>> 7) % 2 = 1 then -(((h % 128) * 4 : Nat) : Int) else (((h % 128) * 4 : Nat) : Int)),
     .keep, none, false⟩
  -- PUSH, POP
  else if h >>> 9 = 0b1011010 then
    ⟨.add (-((4 * (popcount8 h + (h >>> 8) % 2) : Nat) : Int)), .push (popcount8 h + (h >>> 8) % 2), none, false⟩
  else if h >>> 9 = 0b1011110 then
    ⟨.add (((4 * (popcount8 h + (h >>> 8) % 2) : Nat) : Int)), .keep, none, false⟩
  -- high registers: ADD/MOV to SP, ADD/MOV from SP
  else if h >>> 10 = 0b010001 then
    let opc := (h >>> 8) % 4
    let d := ((h >>> 7) % 2) * 8 + h % 8
    let m := (h >>> 3) % 16
    ⟨if (opc = 0 ∨ opc = 2) ∧ d = 13 then .any else .keep, .keep, none,
     decide ((opc = 0 ∨ opc = 2) ∧ m = 13 ∧ d ≠ 13)⟩
  -- other stores: register offset (STR, STRH, STRB), immediate offset, STM
  else if (h >>> 12 = 0b0101 ∧ (h >>> 9) % 8 < 3) ∨
      ((h >>> 13 = 0b011 ∨ h >>> 12 = 0b1000) ∧ (h >>> 11) % 2 = 0) ∨
      (h >>> 12 = 0b1100 ∧ (h >>> 11) % 2 = 0) then ⟨.keep, .other, none, false⟩
  else ⟨.keep, .keep, none, false⟩

/-- The address `x mod 2^32`. -/
def aOf (x : Int) : Nat := (x % (U : Int)).toNat

/-- The condition code of a conditional branch. -/
def ccOf (c : Code) (a : Nat) : Nat := ((c.get a).getD 0 >>> 8) % 16

/-! ### Flags, conditions and values (the data semantics, used by `ThumbData`) -/

structure Flags where
  n : Bool
  z : Bool
  c : Bool
  v : Bool
  deriving DecidableEq, Repr

structure MState where
  r : Nat → Nat
  f : Flags
  sp : Nat
  mem : Nat → Nat

/-- The signed value of a word. -/
def sgn (x : Nat) : Int := if x < 2147483648 then x else (x : Int) - 4294967296

/-- The flags of `a + b` (AddWithCarry with carry 0). -/
def flagsAdd (a b : Nat) : Flags :=
  ⟨decide ((a + b) % U ≥ 2147483648), decide ((a + b) % U = 0), decide (a + b ≥ U),
   decide ¬(-2147483648 ≤ sgn a + sgn b ∧ sgn a + sgn b < 2147483648)⟩

/-- The flags of `a − b` (AddWithCarry of `a`, `NOT b` and carry 1). -/
def flagsSub (a b : Nat) : Flags :=
  ⟨decide ((a + (U - b)) % U ≥ 2147483648), decide ((a + (U - b)) % U = 0), decide (a ≥ b),
   decide ¬(-2147483648 ≤ sgn a - sgn b ∧ sgn a - sgn b < 2147483648)⟩

/-- The ARM conditions (14 and 15: always). -/
def condHolds (cc : Nat) (f : Flags) : Bool :=
  match cc with
  | 0 => f.z
  | 1 => !f.z
  | 2 => f.c
  | 3 => !f.c
  | 4 => f.n
  | 5 => !f.n
  | 6 => f.v
  | 7 => !f.v
  | 8 => f.c && !f.z
  | 9 => !f.c || f.z
  | 10 => f.n == f.v
  | 11 => f.n != f.v
  | 12 => !f.z && f.n == f.v
  | 13 => f.z || f.n != f.v
  | _ => true

def srcVal (r : Nat → Nat) : Src → Nat
  | .reg i => r i
  | .imm k => k

def valOf (r : Nat → Nat) : Val → Option Nat
  | .add a b => some ((srcVal r a + srcVal r b) % U)
  | .sub a b => some ((srcVal r a + (U - srcVal r b)) % U)
  | .shl a k => some ((srcVal r a * 2 ^ k) % U)
  | .any => none

/-! ### Linear constraints

Variables: `0`-`7` the registers before the instruction, `8`, `9` the ghost operands of
the operation that set the flags, `10`-`17` the registers after it when written with any
value, `18`, `19` the ghosts after it when the flags change with any value. A constraint
`e` means `e ≤ 0`. -/

/-- `Σ k·x_v + c` as a constraint. -/
def mk (terms : List (Int × Nat)) (c : Int) : Lin :=
  ⟨terms.foldr (fun t acc => vadd (vsmul t.1 (unit t.2)) acc) [], [], c⟩

/-- `fa − fb + c ≤ 0` and `fb − fa + c ≤ 0`. -/
def dle (c : Int) : Lin := mk [(1, 8), (-1, 9)] c
def dge (c : Int) : Lin := mk [(-1, 8), (1, 9)] c
/-- `x_v < 2^31` and `x_v ≥ 2^31` (non-negative and negative as signed words). -/
def lo (v : Nat) : Lin := mk [(1, v)] (1 - 2147483648)
def hi (v : Nat) : Lin := mk [(-1, v)] 2147483648
/-- `s·(fa + fb) + c ≤ 0`. -/
def sumC (s c : Int) : Lin := mk [(s, 8), (s, 9)] c

/-- The facts of a condition after a subtraction `fa − fb` (condition codes as in ARM). -/
def subFacts : Nat → List (List Lin)
  | 0 => [[dle 0, dge 0]]
  | 1 => [[dle 1], [dge 1]]
  | 2 => [[dge 0]]
  | 3 => [[dle 1]]
  | 8 => [[dge 1]]
  | 9 => [[dle 0]]
  | 10 => [[lo 8, lo 9, dge 0], [hi 8, hi 9, dge 0], [lo 8, hi 9]]
  | 11 => [[lo 8, lo 9, dle 1], [hi 8, hi 9, dle 1], [hi 8, lo 9]]
  | 12 => [[lo 8, lo 9, dge 1], [hi 8, hi 9, dge 1], [lo 8, hi 9]]
  | 13 => [[lo 8, lo 9, dle 0], [hi 8, hi 9, dle 0], [hi 8, lo 9]]
  | _ => [[]]

/-- The facts of a condition after an addition `fa + fb`. -/
def addFacts : Nat → List (List Lin)
  | 0 => [[sumC 1 0, sumC (-1) 0], [sumC 1 (-(U : Int)), sumC (-1) U]]
  | 1 => [[sumC (-1) 1, sumC 1 (1 - (U : Int))], [sumC (-1) ((U : Int) + 1)]]
  | 2 => [[sumC (-1) U]]
  | 3 => [[sumC 1 (1 - (U : Int))]]
  | 8 => [[sumC (-1) ((U : Int) + 1)]]
  | 9 => [[sumC 1 (-(U : Int))]]
  | _ => [[]]

/-- The operation that set the flags at an instruction (`none`: unknown). -/
inductive FKind where
  | none
  | add
  | sub
  deriving DecidableEq, Repr

/-- The facts of the branch `taken` (or not) of condition `cc`, as a disjunction. -/
def condFacts (k : FKind) (cc : Nat) (taken : Bool) : List (List Lin) :=
  let c := if taken then cc else cc ^^^ 1
  match k with
  | .none => [[]]
  | .sub => subFacts c
  | .add => addFacts c

/-! ### Affine expressions and substitution -/

def pv (i : Nat) : PExp := ⟨unit i, 0⟩
def pconst (k : Int) : PExp := ⟨[], k⟩
def padd (a b : PExp) : PExp := ⟨vadd a.sv b.sv, a.c + b.c⟩
def psmul (k : Int) (a : PExp) : PExp := ⟨vsmul k a.sv, k * a.c⟩

def srcE : Src → PExp
  | .reg i => pv i
  | .imm k => pconst k

/-- The value of a write as an expression, with `m·2^32` added (the wrap case `m`); for a
    shift, `a · 2^k` if `m = 0` (no overflow), otherwise the value after (variable `10 + i`). -/
def valE (v : Val) (m : Int) (i : Nat) : PExp :=
  match v with
  | .add a b => padd (padd (srcE a) (srcE b)) (pconst (m * U))
  | .sub a b => padd (padd (srcE a) (psmul (-1) (srcE b))) (pconst (m * U))
  | .shl a k => if m = 0 then psmul ((2 ^ k : Nat) : Int) (srcE a) else pv (10 + i)
  | .any => pv (10 + i)

/-- The value of variable `i < 10` after the instruction, in wrap case `m`. -/
def postE (e : Eff) (m : Int) (i : Nat) : PExp :=
  if i < 8 then
    match e.dst.find? (fun p => p.1 == i) with
    | some p => valE p.2 m i
    | none => pv i
  else
    match e.fl with
    | .keep => pv i
    | .any => pv (i + 10)
    | .add a b => srcE (if i = 8 then a else b)
    | .sub a b => srcE (if i = 8 then a else b)

/-- `Σ l[v]·σ(v)`. -/
def substSv : List Int → (Nat → PExp) → PExp
  | [], _ => pconst 0
  | a :: l, σ => padd (psmul a (σ 0)) (substSv l (fun i => σ (i + 1)))

def substL (g : Lin) (σ : Nat → PExp) : Lin :=
  let p := substSv g.sv σ
  ⟨p.sv, g.lv, g.c + p.c⟩

def substP (g : PExp) (σ : Nat → PExp) : PExp :=
  let p := substSv g.sv σ
  ⟨p.sv, g.c + p.c⟩

/-- `k + p − q ≤ 0`. -/
def goalLin (k : Int) (p q : PExp) : Lin := ⟨vadd p.sv (vsmul (-1) q.sv), [], k + p.c - q.c⟩

/-- The written register whose value is a sum or difference (at most one, `wfEff`). -/
def isOp : Val → Bool
  | .any => false
  | _ => true

def opOf (e : Eff) : Option (Nat × Val) := e.dst.find? fun p => isOp p.2

/-- `0 ≤ value ≤ 2^32 − 1` in wrap case `m`; for a shift in a case `m ≠ 0` (overflow),
    `a · 2^k ≥ 2^32`. -/
def wrapPrem (e : Eff) (m : Int) : List Lin :=
  match opOf e with
  | some (i, v) =>
    match v with
    | .shl a k =>
      if m = 0 then
        let x := valE v m i
        [⟨vsmul (-1) x.sv, [], -x.c⟩, ⟨x.sv, [], x.c - ((U : Int) - 1)⟩]
      else
        let x := psmul ((2 ^ k : Nat) : Int) (srcE a)
        [⟨vsmul (-1) x.sv, [], (U : Int) - x.c⟩]
    | _ =>
      let x := valE v m i
      [⟨vsmul (-1) x.sv, [], -x.c⟩, ⟨x.sv, [], x.c - ((U : Int) - 1)⟩]
  | none => []

def mcases (e : Eff) : List Int := if (opOf e).isSome then [0, 1, -1] else [0]

/-- Every variable below `n` in `[0, 2^32 − 1]`. -/
def rangesN (n : Nat) : List Lin :=
  (List.range n).flatMap fun v => [mk [(-1, v)] 0, mk [(1, v)] (1 - (U : Int))]

/-- The variables of a function with `S` tracked words of the frame: `0`-`19` as above,
    `20`..`20+S-1` the tracked words before the instruction, `20+S`..`20+2S-1` after it
    when they change with any value. -/
def nVars (S : Nat) : Nat := 20 + 2 * S

/-- The tracked word of the frame at offset `k` (the word at `SP₀ − k`, `SP₀` the stack
    pointer at the function's entry). -/
def slotIdx (slots : List Nat) (k : Int) : Option Nat := if 0 < k then find slots k.toNat else none

/-- The value of variable `i` after the instruction, with the stack: as `postE`, except a
    word loaded from a tracked slot, and the tracked slots themselves (`δ`: the offset of
    the stack pointer from its value at the entry, if known). -/
def postS (e : Eff) (s : StackE) (frame : Bool) (δ : Option Int) (slots : List Nat) (m : Int)
    (i : Nat) : PExp :=
  if i < 8 then
    match s.load, δ with
    | some p, some d =>
      if i = p.1 then
        match slotIdx slots (-(d + (p.2 : Int))) with
        | some j => pv (20 + j)
        | none => postE e m i
      else postE e m i
    | _, _ => postE e m i
  else if i < 20 then postE e m i
  else
    let S := slots.length
    let k : Int := ((slots.getD (i - 20) 0 : Nat) : Int)
    match s.mem with
    | .keep => pv i
    | .storeSP imm rt => match δ with
      | some d => if k = -(d + (imm : Int)) then pv rt else pv i
      | none => pv (i + S)
    | .push n => match δ with
      | some d => if d - 4 * (n : Int) ≤ -k ∧ -k < d then pv (i + S) else pv i
      | none => pv (i + S)
    | .other => match δ with
      | some d => if frame = true ∧ k ≤ -d then pv i else pv (i + S)
      | none => pv (i + S)

/-- Registers below 8, constants below `2^32`, at most one written sum or difference. -/
def srcOk : Src → Bool
  | .reg i => decide (i < 8)
  | .imm k => decide (k < U)

def valOk : Val → Bool
  | .add a b => srcOk a && srcOk b
  | .sub a b => srcOk a && srcOk b
  | .shl a k => srcOk a && decide (k < 32)
  | .any => true

def wfEff (e : Eff) : Bool :=
  e.dst.all (fun p => decide (p.1 < 8) && valOk p.2) &&
  decide ((e.dst.filter fun p => isOp p.2).length ≤ 1) &&
  (match e.fl with
   | .add a b => srcOk a && srcOk b
   | .sub a b => srcOk a && srcOk b
   | _ => true)

/-- Registers below 8, offsets below 1024, at most 16 words pushed. -/
def stackLoadOk : Option (Nat × Nat) → Bool
  | none => true
  | some p => decide (p.1 < 8 ∧ p.2 < 1024)

def stackMemOk : MemE → Bool
  | .storeSP imm rt => decide (imm < 1024 ∧ rt < 8)
  | .push n => decide (n ≤ 16)
  | _ => true

def stackWf (s : StackE) : Bool := stackLoadOk s.load && stackMemOk s.mem

/-- The kind of operation after the instruction may be the one it sets, or unknown. -/
def kindOk (ka : FKind) (fl : FEff) (kn : FKind) : Bool :=
  kn == .none ||
  match fl with
  | .keep => kn == ka
  | .any => false
  | .add _ _ => kn == .add
  | .sub _ _ => kn == .sub

/-! ### Certificates -/

/-- A certified loop: header, body, scale `D`, bound `N`, potentials of the body's
    instructions (in the order of `body`; missing ones are `0`). -/
structure LoopCert where
  header : Nat
  body : List Nat
  scale : Nat
  bound : Nat
  pot : List PExp
  deriving DecidableEq, Repr

/-- The certificate of a function: per instruction (in the order of `BFun.nodes`) the
    kind of flags and the invariant; the certified loops; the rows still trusted; Farkas
    certificates of the obligations, in the order of `obligations`. -/
structure DFun where
  kinds : List FKind
  inv : List (List Lin)
  loops : List LoopCert
  trusted : List MRow
  proofs : List (Nat × List Nat)
  spOff : List (Option Int) := []
  slots : List Nat := []
  frame : Bool := false
  /-- Per instruction: congruences `(v, e, r)`, "variable `v` is `r` modulo `2^e`". -/
  cong : List (List (Nat × Nat × Nat)) := []
  /-- Per instruction: further disjuncts of the invariant (the invariant at `a` is the
      disjunction of `inv` and of these). -/
  alt : List (List (List Lin)) := []
  /-- Per instruction: targets `(j, m, d, s, t)`: the case of transition `j`, wrap-around
      `m`, branch fact `d` and source disjunct `s` lands in the disjunct `t` of the next
      instruction's invariant (`0`, the disjunct `inv`, when none is given). -/
  pick : List (List (Nat × Int × Nat × Nat × Nat)) := []
  deriving Repr

def kindAt (f : BFun) (L : DFun) (a : Nat) : FKind :=
  ((find f.nodes a).bind fun k => L.kinds[k]?).getD .none

def invAt (f : BFun) (L : DFun) (a : Nat) : List Lin :=
  ((find f.nodes a).bind fun k => L.inv[k]?).getD []

/-- The disjuncts of the invariant at `a`: `invAt` first, then the alternatives. -/
def invsAt (f : BFun) (L : DFun) (a : Nat) : List (List Lin) :=
  invAt f L a :: ((find f.nodes a).bind fun k => L.alt[k]?).getD []

/-- The disjunct of the next instruction's invariant that a case lands in. -/
def tgtIdx (f : BFun) (L : DFun) (a j : Nat) (m : Int) (d s : Nat) : Nat :=
  ((((find f.nodes a).bind fun k => L.pick[k]?).getD []).find? fun x =>
    x.1 == j && x.2.1 == m && x.2.2.1 == d && x.2.2.2.1 == s).elim 0 fun x => x.2.2.2.2

/-- The disjunct `t` of the invariant at `n` (the first one if there is no disjunct `t`). -/
def tgtInv (f : BFun) (L : DFun) (n t : Nat) : List Lin :=
  ((invsAt f L n)[t]?).getD (invAt f L n)

/-- The offset of the stack pointer from its value at the entry, at instruction `a`. -/
def spAt (f : BFun) (L : DFun) (a : Nat) : Option Int :=
  ((find f.nodes a).bind fun k => L.spOff[k]?).getD none

/-! ### Congruences modulo powers of two

Granger's congruences, restricted to moduli `2^e`: a counter stepped by 4 from 0 stays a
multiple of 4. They are checked without Farkas certificates, along every transition, on the
same post-expressions as the invariants, and used in one place: at a conditional branch,
when the two ghost operands are congruent modulo `2^e`, the facts of the condition on
their difference are rounded to multiples of `2^e` (`x ≠ 80` and `x ≤ 80`, `x` a multiple
of 4, give `x ≤ 76`). -/

abbrev Cong := Nat × Nat × Nat

def congAt (f : BFun) (L : DFun) (a : Nat) : List Cong :=
  ((find f.nodes a).bind fun k => L.cong[k]?).getD []

/-- The congruence of variable `v` in `cs`: `(e, r)`, or `(0, 0)` (nothing known). -/
def congOf (cs : List Cong) (v : Nat) : Nat × Nat :=
  match cs.find? (fun x => x.1 == v) with
  | some x => (x.2.1, x.2.2)
  | none => (0, 0)

/-- The largest `e` (at most 32) such that the two ghost operands are congruent modulo `2^e`. -/
def gExp (cs : List Cong) : Nat :=
  let x := congOf cs 8
  let y := congOf cs 9
  ((List.range 33).filter fun e => decide (e ≤ x.1 ∧ e ≤ y.1 ∧
    (x.2 : Int) % (2 ^ e : Nat) = (y.2 : Int) % (2 ^ e : Nat))).foldl max 0

/-- A difference fact `±(g₈ − g₉) + c ≤ 0` with `c` rounded up to a multiple of `2^e`. -/
def tightenL (e : Nat) (g : Lin) : Lin :=
  if 0 < e ∧ g.lv = [] ∧ (g.sv = (dle 0).sv ∨ g.sv = (dge 0).sv) then
    ⟨g.sv, [], -(((-g.c) / ((2 ^ e : Nat) : Int)) * ((2 ^ e : Nat) : Int))⟩
  else g

/-- The largest `e ≤ 32` such that the congruences make `g₈ + g₉` a multiple of `2^e`. -/
def gExpS (cs : List Cong) : Nat :=
  let x := congOf cs 8
  let y := congOf cs 9
  ((List.range 33).filter fun e => decide (e ≤ x.1 ∧ e ≤ y.1 ∧
    ((x.2 : Int) + y.2) % (2 ^ e : Nat) = 0)).foldl max 0

/-- A sum fact `±(g₈ + g₉) + c ≤ 0` with `c` rounded up to a multiple of `2^e`. -/
def tightenS (e : Nat) (g : Lin) : Lin :=
  if 0 < e ∧ g.lv = [] ∧ (g.sv = (sumC 1 0).sv ∨ g.sv = (sumC (-1) 0).sv) then
    ⟨g.sv, [], -(((-g.c) / ((2 ^ e : Nat) : Int)) * ((2 ^ e : Nat) : Int))⟩
  else g

/-- The facts of a condition, rounded with the congruences of the ghost operands: the
    facts on their difference with `e`, those on their sum with `es`. -/
def condFactsM (k : FKind) (cc : Nat) (taken : Bool) (e es : Nat) : List (List Lin) :=
  (condFacts k cc taken).map (·.map (fun g => tightenS es (tightenL e g)))

/-- `Σ k_v·x_v` (from variable `v`) modulo `2^e` under `cs`: each term must be determined
    modulo `2^e` (`2^e` divides `k_v·2^{e_v}`); its residue. -/
def congSv (cs : List Cong) (e : Nat) : Nat → List Int → Option Int
  | _, [] => some 0
  | v, k :: t =>
    match congSv cs e (v + 1) t with
    | some b =>
      if (k * ((2 ^ (congOf cs v).1 : Nat) : Int)) % ((2 ^ e : Nat) : Int) = 0 then
        some (k * (congOf cs v).2 + b)
      else none
    | none => none

/-- The expression `P` is `r` modulo `2^e` under the congruences `cs`. -/
def congPE (cs : List Cong) (e r : Nat) (P : PExp) : Bool :=
  match congSv cs e 0 P.sv with
  | some t => decide ((t + P.c) % ((2 ^ e : Nat) : Int) = (r : Int) % ((2 ^ e : Nat) : Int))
  | none => false

/-- Congruences on the variables of a state, with exponents at most 32. -/
def wfCong (S : Nat) (x : Cong) : Bool :=
  decide (x.1 < 10 ∨ 20 ≤ x.1 ∧ x.1 < 20 + S) && decide (x.2.1 ≤ 32)

def potAt (lc : LoopCert) : Option Nat → PExp
  | none => pconst 0
  | some a => ((find lc.body a).bind fun k => lc.pot[k]?).getD (pconst 0)

/-- The coefficient of the transition `a → next` in the row of a loop. -/
def coefStep (lc : LoopCert) (a : Nat) (next : Option Nat) : Int :=
  if next = some lc.header then (if a ∈ lc.body then (lc.scale : Int) else -(lc.bound : Int)) else 0

def rowRhs (f : BFun) (lc : LoopCert) : Int := if f.entry ∈ lc.body then lc.bound else 0

/-- The row of a certified loop, on the transitions from every instruction to the header. -/
def loopRow (f : BFun) (lc : LoopCert) : MRow :=
  ⟨f.nodes.map fun u => (u, lc.header, if u ∈ lc.body then (lc.scale : Int) else -(lc.bound : Int)),
   rowRhs f lc⟩

/-- The obligations of the transitions of the instruction at `a`. -/
def obsOf (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) (a : Nat) :
    List (List Lin × Lin) :=
  match decode mul c a with
  | none => []
  | some i =>
    let e := effect abi c a
    let st := stackEffect abi c a
    let ka := kindAt f L a
    (indexed 0 (transJ f.jumps i a)).flatMap fun p =>
      let next := p.2.1
      let facts := match i.kind with
        | .cond _ => condFactsM ka (ccOf c a) (p.1 == 0) (gExp (congAt f L a)) (gExpS (congAt f L a))
        | _ => [[]]
      (mcases e).flatMap fun m => (indexed 0 facts).flatMap fun q =>
        (indexed 0 (invsAt f L a)).flatMap fun r =>
        let prem := q.2 ++ wrapPrem e m ++ r.2 ++ rangesN (nVars L.slots.length)
        let σ := postS e st L.frame (spAt f L a) L.slots m
        let invGoals := match next with
          | some n => (tgtInv f L n (tgtIdx f L a p.1 m q.1 r.1)).map fun g => substL g σ
          | none => []
        let loopGoals := L.loops.map fun lc =>
          goalLin (coefStep lc a next) (substP (potAt lc next) σ) (potAt lc (some a))
        (invGoals ++ loopGoals).map fun g => (prem, g)

/-- All obligations: the invariant and the potentials at the entry (from the ranges
    alone), then those of every transition. -/
def obligations (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) :
    List (List Lin × Lin) :=
  (invAt f L f.entry).map (fun g => (rangesN (nVars L.slots.length), g)) ++
  L.loops.map (fun lc => (rangesN (nVars L.slots.length),
    goalLin (-(rowRhs f lc)) (potAt lc (some f.entry)) (pconst 0))) ++
  f.nodes.flatMap (obsOf mul abi c f L)

def checkObs : List (List Lin × Lin) → List (Nat × List Nat) → Bool
  | [], [] => true
  | o :: os, p :: ps => entails1 o.1 o.2 p && checkObs os ps
  | _, _ => false

/-- No repetition. -/
def nodupB : List Nat → Bool
  | [] => true
  | x :: xs => !(xs.contains x) && nodupB xs

/-- A constraint or potential on the variables of a state: registers, ghosts and the `S`
    tracked words (not on the variables `10`-`19` of a transition). -/
def wfSv (S : Nat) (sv : List Int) : Bool :=
  decide (sv.length ≤ 20 + S) && (List.range 10).all fun v => sv.getD (10 + v) 0 == 0

def wfLin (S : Nat) (g : Lin) : Bool := g.lv.isEmpty && wfSv S g.sv

/-- The stack pointer after the instruction: unknown, or the offset the effect gives. -/
def spOk (da : Option Int) (s : SpE) (dn : Option Int) : Bool :=
  match dn with
  | none => true
  | some n => match da, s with
    | some d, .keep => n == d
    | some d, .add k => n == d + k
    | _, _ => false

/-- Tracked words: distinct positive multiples of 4 below `2^20`; offsets of the stack
    pointer within `±2^20`. -/
def slotsOk (L : DFun) : Bool :=
  nodupB L.slots && L.slots.all (fun k => decide (0 < k ∧ k % 4 = 0 ∧ k < 1048576)) &&
  L.spOff.all fun o => match o with
    | some d => decide (-1048576 ≤ d ∧ d ≤ 1048576)
    | none => true

/-! ### The frame pointer

The usual prologue `PUSH {.., r7, lr}; ADD r7, SP, #imm` puts an address of the frame in
`r7`. The assumption `frame` (stores through registers other than SP, and calls, do not
write the frame) is trusted, not proved; the checks below only restrict the code it may be
used on: an address of the frame may be in no register but SP and, after the prologue,
`r7`, and `r7` may then be read only as the base address of a load or by a `PUSH` at the
entry. Over-approximation: every register field an encoding may read is counted. The
soundness proof does not use these checks. -/

/-- `ADD r7, SP, #imm`. -/
def fpSetup (c : Code) (a : Nat) : Bool :=
  match c.get a with
  | some h => h >>> 11 == 0b10101 && (h >>> 8) % 8 == 7
  | none => false

/-- `PUSH`. -/
def isPush (c : Code) (a : Nat) : Bool :=
  match c.get a with
  | some h => h >>> 9 == 0b1011010
  | none => false

/-- The registers an instruction may read, other than the base register of a load
    (an over-approximation, by encoding: destinations of some encodings are included). -/
def regsRead (h : Nat) : List Nat :=
  let f0 := h % 8
  let f3 := (h >>> 3) % 8
  let f6 := (h >>> 6) % 8
  let f8 := (h >>> 8) % 8
  let top5 := h >>> 11
  -- 32-bit instructions (only BL is decoded): none
  if top5 = 0b11101 ∨ top5 = 0b11110 ∨ top5 = 0b11111 then []
  -- ADD/SUB register or 3-bit immediate
  else if top5 = 0b00011 then (if (h >>> 10) % 2 = 0 then [f3, f6] else [f3])
  -- shifts by an immediate
  else if h >>> 13 = 0 then [f3]
  -- MOV/CMP/ADD/SUB 8-bit immediate
  else if h >>> 13 = 0b001 then [f8]
  -- data processing
  else if h >>> 10 = 0b010000 then [f0, f3]
  -- high registers, BX, BLX
  else if h >>> 10 = 0b010001 then [((h >>> 7) % 2) * 8 + f0, (h >>> 3) % 16]
  -- LDR literal
  else if top5 = 0b01001 then []
  -- load/store, register offset: a store reads Rt, Rn, Rm; a load Rm
  else if h >>> 12 = 0b0101 then (if (h >>> 9) % 8 < 3 then [f0, f3, f6] else [f6])
  -- load/store, immediate offset (word, byte, halfword): a store reads Rt and Rn
  else if h >>> 13 = 0b011 ∨ h >>> 12 = 0b1000 then (if (h >>> 11) % 2 = 0 then [f0, f3] else [])
  -- STR/LDR SP-relative
  else if h >>> 12 = 0b1001 then (if (h >>> 11) % 2 = 0 then [f8] else [])
  -- ADR, ADD rd, SP
  else if h >>> 12 = 0b1010 then []
  -- PUSH: the registers of the list
  else if h >>> 9 = 0b1011010 then (List.range 8).filter fun r => (h >>> r) % 2 = 1
  -- POP, ADD/SUB SP: none; other miscellaneous instructions (extensions, REV): Rm
  else if h >>> 9 = 0b1011110 ∨ h >>> 8 = 0b10110000 then []
  else if h >>> 12 = 0b1011 then [f3]
  -- STM: base and list; LDM: none
  else if h >>> 11 = 0b11000 then f8 :: (List.range 8).filter fun r => (h >>> r) % 2 = 1
  else []

/-- The instruction at `a` may read `r7` (not counting the base register of a load). -/
def readsR7 (c : Code) (a : Nat) : Bool :=
  match c.get a with
  | some h => (regsRead h).contains 7
  | none => true

/-- The code the assumption `frame` may be used on: see above. -/
def frameUseOk (c : Code) (f : BFun) (a : Nat) : Bool :=
  (!(stackEffect false c a).escapes || fpSetup c a) &&
  (!(f.nodes.any (fpSetup c)) || !(readsR7 c a) || (a == f.entry && isPush c a))

/-- The checks that do not involve Farkas certificates, at instruction `a`. -/
def nodeOk (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) (a : Nat) : Bool :=
  wfEff (effect abi c a) && !(L.frame && !frameUseOk c f a) && stackWf (stackEffect abi c a) &&
  match decode mul c a with
  | none => false
  | some i => (transJ f.jumps i a).all fun p => match p.1 with
    | some n => kindOk (kindAt f L a) (effect abi c a).fl (kindAt f L n) &&
        spOk (spAt f L a) (stackEffect abi c a).sp (spAt f L n)
    | none => true

/-- The congruences after every transition of the instruction at `a`, in every wrap case. -/
def congOk (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) (a : Nat) : Bool :=
  match decode mul c a with
  | none => true
  | some i => (transJ f.jumps i a).all fun p => match p.1 with
    | some n => (mcases (effect abi c a)).all fun m => (congAt f L n).all fun x =>
        congPE (congAt f L a) x.2.1 x.2.2
          (postS (effect abi c a) (stackEffect abi c a) L.frame (spAt f L a) L.slots m x.1)
    | none => true

/-- The checks of the congruences: none at the entry, well formed, preserved. -/
def congChecks (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) : Bool :=
  (congAt f L f.entry).isEmpty && L.cong.all (·.all (wfCong L.slots.length)) &&
  f.nodes.all (congOk mul abi c f L)

/-! ### Jumps through a table: the window

The instructions between the `BHI` and the jump are evaluated on partial registers
(`none`: unknown) by their effect (`effect`) and, for `ADD rd, PC`, `ADR` and the loads from
the code, by `xres`: `wrun`. `jumpOk` evaluates the window for every value of the compared
register allowed by the branch not taken, and requires the address computed for the jump to
be a listed target; `interiorOk` requires that nothing enters the window but from the
instruction before (so that every run reaching the jump has executed the whole window). -/

def srcP (P : Nat → Option Nat) : Src → Option Nat
  | .reg i => P i
  | .imm k => some k

def valP (P : Nat → Option Nat) : Val → Option Nat
  | .add a b => (srcP P a).bind fun x => (srcP P b).map fun y => (x + y) % U
  | .sub a b => (srcP P a).bind fun x => (srcP P b).map fun y => (x + (U - y)) % U
  | .shl a k => (srcP P a).map fun x => (x * 2 ^ k) % U
  | .any => none

/-- The low registers after the instruction at `a`, from those before. -/
def wstep (abi : Bool) (c : Code) (a : Nat) (P : Nat → Option Nat) : Nat → Option Nat := fun i =>
  if i < 8 then
    match (effect abi c a).dst.find? (fun p => p.1 == i) with
    | none => P i
    | some p => match xop c a with
      | some op => if op.dst = i then xres c a P op else valP P p.2
      | none => valP P p.2
  else none

/-- `wstep` on `k` consecutive instructions from `a`. -/
def wrun (abi : Bool) (c : Code) : Nat → Nat → (Nat → Option Nat) → (Nat → Option Nat)
  | 0, _, P => P
  | k + 1, a, P => wrun abi c k (a + 2) (wstep abi c a P)

/-- The form of the window: `BLS` to `start + 6` (over a branch to the default case at
    `start + 4`), rather than `BHI` to the default case. -/
def lsForm (c : Code) (t : JT) : Bool := ccOf c (t.start + 2) == 9

/-- The first address of the window evaluated: after the branch not taken, or at the target
    of `BLS`. -/
def wbeg (c : Code) (t : JT) : Nat := if lsForm c t then t.start + 6 else t.start + 4

/-- The instruction before an address of the window, on its path. -/
def wpred (c : Code) (t : JT) (p : Nat) : Nat :=
  if lsForm c t ∧ p = t.start + 6 then t.start + 2 else p - 2

/-- The addresses of the window after the `CMP`: the branch, then from `wbeg` to the jump. -/
def interior (c : Code) (t : JT) : List Nat :=
  (t.start + 2) :: (List.range ((t.pos + 2 - wbeg c t) / 2)).map fun k => wbeg c t + 2 * k

/-- The window of a jump: `CMP rI, #n` at `start` (its effect), at `start + 2` a `BHI` not
    to `start + 4` or a `BLS` to `start + 6`, the jump at `pos`; for every `rI ≤ n`, the
    address computed for the jump is a target. -/
def jumpOk (abi : Bool) (mul : Nat) (c : Code) (t : JT) : Bool :=
  match effect abi c t.start, decode mul c (t.start + 2), pcWrite c t.pos with
  | ⟨[], .sub (.reg r) (.imm n)⟩, some ⟨_, .cond tb, _, _⟩, some (add, m) =>
    decide (r < 8) && decide (n < U) &&
    (if lsForm c t then tb == t.start + 6 else ccOf c (t.start + 2) == 8 && tb != t.start + 4) &&
    effect abi c (t.start + 2) == ⟨[], .keep⟩ &&
    decode mul c (t.start + 2) == some ⟨2, .cond tb, 3, 1⟩ &&
    decide (wbeg c t ≤ t.pos) && (t.pos - t.start) % 2 == 0 &&
    (List.range (n + 1)).all fun x =>
      match wrun abi c ((t.pos - wbeg c t) / 2) (wbeg c t) (fun i => if i = r then some x else none) m with
      | some v => decide (pcDestV t.pos add v ∈ t.tgts)
      | none => false
  | _, _, _ => false

/-- Nothing enters the window of a jump except from the instruction before it on its path
    (`wpred`), the entry is not in it, and no listed jump is at its branch. -/
def interiorOk (mul : Nat) (c : Code) (f : BFun) : Bool :=
  f.jumps.all fun t => !(interior c t).contains f.entry && jumpTr f.jumps (t.start + 2) == [] &&
    (medges mul c f.jumps f.nodes).all fun m => match m.2.1 with
      | some p => !(interior c t).contains p || m.1 == wpred c t p
      | none => true

/-- The check of the loop certificates of a function. -/
def checkDFun (mul : Nat) (abi : Bool) (c : Code) (f : BFun) (L : DFun) : Bool :=
  closed mul c f.jumps f.entry f.nodes && nodupB f.nodes &&
  decide (f.rows = L.trusted ++ L.loops.map (loopRow f)) &&
  f.nodes.all (nodeOk mul abi c f L) && kindAt f L f.entry == .none &&
  (spAt f L f.entry == some 0 || spAt f L f.entry == none) && slotsOk L &&
  L.inv.all (·.all (wfLin L.slots.length)) &&
  L.alt.all (·.all (·.all (wfLin L.slots.length))) &&
  L.loops.all (fun lc => lc.pot.all fun p => wfSv L.slots.length p.sv) &&
  checkObs (obligations mul abi c f L) L.proofs && congChecks mul abi c f L &&
  f.jumps.all (jumpOk abi mul c) && interiorOk mul c f

/-- The check of the loop certificates of all functions (aligned with the functions);
    `abi`: callees preserve `r4`-`r7` and the stack pointer; a certificate with `frame`
    assumes that no store through a register other than SP, and no call, writes the
    function's frame, and the function must not put an address of its frame in a register. -/
def checkData (mul : Nat) (abi : Bool) (c : Code) (fs : List BFun) (Ls : List DFun) : Bool :=
  fs.length == Ls.length && (fs.zip Ls).all fun p => checkDFun mul abi c p.1 p.2

/-! ### The calling convention, checked on the code (`ThumbConv`)

Instead of assuming that callees preserve `r4`-`r7` and SP, the checker can verify it on
each function of the certificate: the function saves at its entry, with one `PUSH`, the
registers of `r4`-`r7` that it writes (and `lr`), writes no other register of `r4`-`r7`,
restores them at every return with a `POP` of the same list (and `pc`) at the offset of SP
where they were saved (or returns with `BX LR` when it saved nothing and SP is back at its
entry value), and stores through SP, or pushes, only below the saved words. `ThumbConv`
proves that every function so checked returns with `r4`-`r7` and SP as it found them,
assuming only that the saved words are written by no other instruction (no stack smashing). -/

/-- `PUSH` at `h`. -/
def isPushH (h : Nat) : Bool := h >>> 9 == 0b1011010

/-- The register list (bits of `r0`-`r7`) pushed at the entry, whether `lr` is pushed, and
    the number of words pushed. -/
def saveList (c : Code) (e : Nat) : Nat := match c.get e with
  | some h => if isPushH h then h % 256 else 0
  | none => 0
def saveLr (c : Code) (e : Nat) : Bool := match c.get e with
  | some h => isPushH h && (h >>> 8) % 2 == 1
  | none => false
def saveN (c : Code) (e : Nat) : Nat := match c.get e with
  | some h => if isPushH h then popcount8 h + (h >>> 8) % 2 else 0
  | none => 0

/-- The conditions at one instruction of `f` (see above). -/
def convNode (mul : Nat) (c : Code) (f : BFun) (L : DFun) (a : Nat) : Bool :=
  let n : Int := (saveN c f.entry : Int)
  let P := saveList c f.entry
  match decode mul c a, c.get a with
  | some i, some h =>
    (transJ f.jumps i a).all (fun t => t.1 != some f.entry) &&
    (if i.kind == .ret then (jumpTr f.jumps a).isEmpty && (
      (h >>> 9 == 0b1011110 && (h >>> 8) % 2 == 1 && h % 256 == P && saveLr c f.entry &&
        spAt f L a == some (-(4 * n))) ||
      (h >>> 8 == 0b01000111 && n == 0 && spAt f L a == some 0))
    else
      (a == f.entry && isPushH h) ||
      ((effect true c a).dst.all (fun p => p.1 < 4 || 8 ≤ p.1 || (P >>> p.1) % 2 == 1) &&
        (match (stackEffect true c a).mem with
         | .storeSP imm _ => match spAt f L a with
           | some d => decide (d + imm < -(4 * n))
           | none => false
         | .push _ => isPushH h && match spAt f L a with
           | some d => decide (d ≤ -(4 * n))
           | none => false
         | _ => true)))
  | _, _ => false

/-- The calling convention of one function. -/
def convOk (mul : Nat) (c : Code) (f : BFun) (L : DFun) : Bool :=
  spAt f L f.entry == some 0 && f.nodes.all (convNode mul c f L)

/-- The calling convention of every function of the certificate. -/
def convAll (mul : Nat) (c : Code) (fs : List BFun) (Ls : List DFun) : Bool :=
  fs.length == Ls.length && (fs.zip Ls).all fun p => convOk mul c p.1 p.2

end ImperativeOptimization.Thumb
